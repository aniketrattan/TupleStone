{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "TUPLESTONE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "ninja",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja"
    },
    {
      "name": "debug",
      "displayName": "Debug (paranoid asserts on)",
      "inherits": "ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TUPLESTONE_PARANOID": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release with debug info",
      "inherits": "ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "TUPLESTONE_PARANOID": "OFF",
        "TUPLESTONE_BUILD_BENCH": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer",
      "inherits": "ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TUPLESTONE_PARANOID": "ON",
        "TUPLESTONE_SANITIZER": "address"
      }
    },
    {
      "name": "ubsan",
      "displayName": "UndefinedBehaviorSanitizer",
      "inherits": "ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TUPLESTONE_PARANOID": "ON",
        "TUPLESTONE_SANITIZER": "undefined"
      }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer",
      "inherits": "ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TUPLESTONE_PARANOID": "OFF",
        "TUPLESTONE_SANITIZER": "thread"
      }
    },

    {
      "name": "mingw-debug",
      "displayName": "Debug, MinGW Makefiles (no Ninja required)",
      "inherits": "base",
      "generator": "MinGW Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TUPLESTONE_PARANOID": "ON"
      }
    },
    {
      "name": "mingw-release",
      "displayName": "Release, MinGW Makefiles (no Ninja required)",
      "inherits": "base",
      "generator": "MinGW Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "TUPLESTONE_PARANOID": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "ubsan", "configurePreset": "ubsan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "mingw-debug", "configurePreset": "mingw-debug" },
    { "name": "mingw-release", "configurePreset": "mingw-release" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    { "name": "debug", "inherits": "base", "configurePreset": "debug" },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    { "name": "asan", "inherits": "base", "configurePreset": "asan" },
    { "name": "ubsan", "inherits": "base", "configurePreset": "ubsan" },
    { "name": "tsan", "inherits": "base", "configurePreset": "tsan" },
    { "name": "mingw-debug", "inherits": "base", "configurePreset": "mingw-debug" },
    { "name": "mingw-release", "inherits": "base", "configurePreset": "mingw-release" }
  ]
}
